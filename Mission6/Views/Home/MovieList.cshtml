

@model IEnumerable<Mission6.Models.Movie>

@{
    ViewBag.Title = "Movie List";
}

<h2 class ="mb-4">Movie List</h2>

<table class="table table-striped table-hover">
    <thead class ="thead-dark">
    <tr>
        <th>Title</th>
        <th>Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var movie in Model)
    {
        <tr>
            <td>@movie.Title</td>
            <td>@movie.Category?.CategoryName</td>
            <td>
                @Html.ActionLink("Details", "Details", new { id = movie.MovieId }, new { @class = "btn btn-warning btn-sm" })
                @Html.ActionLink("Edit", "Edit", new { id = movie.MovieId }, new { @class = "btn btn-warning btn-sm" })
                @Html.ActionLink("Delete", "Delete", new { id = movie.MovieId }, new { @class = "btn btn-warning btn-sm" })
            </td>
        </tr>
    }
    </tbody>
</table>