@model Mission6.Models.Movie

@{
    ViewBag.Title = "Delete Movie";
}



<div class="movie-details">
    <h2>@Model.Title</h2>
    <p><strong>Year:</strong> @Model.Year</p>
    <p><strong>Director:</strong> @Model.Director</p>
    <p><strong>Category:</strong> @Model.Category?.CategoryName</p>
    <p><strong>Rating:</strong> @Model.Rating</p>
    <p><strong>Edited:</strong> @(Model.Edited ? "Yes" : "No")</p>
    <p><strong>Copied To Plex:</strong> @(Model.CopiedToPlex ? "Yes" : "No")</p>
    <p><strong>Lent To:</strong> @Model.LentTo</p>
    <p><strong>Notes:</strong> @Model.Notes</p>
</div>
<h3>Are you sure you want to delete this movie?</h3>

@using (Html.BeginForm("Delete", "Home", new { id = Model.MovieId }, FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">Delete</button>
    @Html.ActionLink("Cancel", "MovieList", null, new { @class = "btn btn-secondary" })
}